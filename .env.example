# Frontend Next.js: copie para front/.env.local no desenvolvimento.
# Inclua /api, pois as rotas do backend usam esse prefixo.
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Backend: configure em back/.env ou no ambiente da hospedagem da API.
# Em producao, use a origem HTTPS do frontend, sem barra final.
# Para mais de uma origem, separe os valores por virgula.
FRONTEND_URL=http://localhost:3000
